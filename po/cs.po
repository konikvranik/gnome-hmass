msgid "Drag to reorder"
msgstr "Přetáhnutím změníte pořadí"

#: prefs.js:970
msgid "Authentication failed (401/403) — check the long-lived token."
msgstr "Přihlášení selhalo (401/403) — zkontrolujte dlouhodobý token."

#: prefs.js:974
msgid "Server returned 404 Not Found — verify the URL."
msgstr "Server vrátil 404 Not Found — ověřte zadanou URL."

#: prefs.js:978
#, javascript-format
