#: prefs.js:609
msgid ""
"Values outside thresholds are highlighted red. Icon, name,\n"
"decimal places and thresholds apply to both the panel and the\n"
"menu; the display mode applies to the panel only (in the menu\n"
"the toggle is the value itself)."
msgstr ""
"Hodnota mimo prahy se zvýrazní červeně. Ikona, název,\n"
"desetinná místa a prahy platí pro lištu i menu; režim\n"
"zobrazení jen pro lištu (v menu u přepínače je hodnotou\n"
"sám přepínač)."

#: prefs.js:670
msgid "Not set"
msgstr "Není nastavena"

#: prefs.js:733
msgid "Add entity…"
msgstr "Přidat entitu…"

#: prefs.js:747 prefs.js:1380
msgid "e.g. sensor.temperature_livingroom"
msgstr "např. sensor.teplota_obyvak"

#: prefs.js:760
msgid "Per-entity settings (icon, decimal places, thresholds…)"
msgstr "Individuální nastavení entity (ikona, desetinná místa, prahy…)"

