msgstr "Chyba spojení: %s"

#: prefs.js:1173
msgid "Enter the Music Assistant URL."
msgstr "Zadejte URL Music Assistant serveru."

#: prefs.js:1192
msgid "Connection timed out (10 s)."
msgstr "Vypršel časový limit spojení (10 s)."

