#: prefs.js:1339 prefs.js:1479
msgid "Connection"
msgstr "Verbinding"

#: prefs.js:1340
msgid "Home Assistant server connection settings"
msgstr "Verbindingsinstellingen voor de Home Assistant-server"

#: prefs.js:1343 prefs.js:1489
msgid "Server URL"
msgstr "Server-URL"

#: prefs.js:1343
msgid "e.g. http://homeassistant.local:8123"
msgstr "bijv. http://homeassistant.local:8123"

#: prefs.js:1346
msgid "Access token"
msgstr "Toegangstoken"

#: prefs.js:1347
msgid "Long-lived token from your Home Assistant user profile"
msgstr "Langlopend token uit je Home Assistant-gebruikersprofiel"

#: prefs.js:1353
msgid "For servers with custom or self-signed certificates (libsoup 3.2+)"
msgstr "Voor servers met eigen of self-signed certificaten (libsoup 3.2+)"

#: prefs.js:1359 prefs.js:1499
msgid "Test connection"
msgstr "Verbinding testen"

#: prefs.js:1360
msgid "Checks the server and loads the entity list"
msgstr "Controleert de server en laadt de entiteitenlijst"

#: prefs.js:1376
msgid "Panel entities"
msgstr "Entiteiten in de bovenbalk"

#: prefs.js:1377
msgid ""
"Entity values (e.g. a temperature sensor) shown directly in the GNOME top "
"bar. Switches, buttons and other controls can be operated right in the bar; "
"the entity name appears on hover."
msgstr ""
"Entiteitswaarden (bijv. een temperatuursensor) die direct in de GNOME-"
"bovenbalk worden getoond. Schakelaars, knoppen en andere bedieningselementen "
"zijn direct in de balk te bedienen; de entiteitnaam verschijnt bij aanwijzen."

#: prefs.js:1383
msgid "Decimal places for numeric values"
msgstr "Decimalen voor numerieke waarden"

#: prefs.js:1384
msgid "Automatic per entity, or a fixed number of decimal places"
msgstr "Automatisch per entiteit, of een vast aantal decimalen"

#: prefs.js:1397
msgid "Entity icons"
msgstr "Entiteitspictogrammen"

#: prefs.js:1398
msgid ""
"Icon source for the panel and menu. \"From Home Assistant (MDI)\" uses the "
"entity's own icon (mdi:…) from the MDI set bundled with the extension"
msgstr ""
"Bron van de pictogrammen voor paneel en menu. \\\"Van Home Assistant (MDI)\\"
"\" gebruikt het eigen pictogram van de entiteit (mdi:…) uit de meegeleverde "
"MDI-set"

#: prefs.js:1406
msgid "No icons"
msgstr "Geen pictogrammen"

#: prefs.js:1413
msgid "Shortcuts"
msgstr "Sneltoetsen"

#: prefs.js:1414
msgid "Extension global keyboard shortcuts"
msgstr "Globale sneltoetsen van de extensie"

#: prefs.js:1417
msgid "Open menu and assistant chat"
msgstr "Menu en assistent-chat openen"

#: prefs.js:1418
msgid "Opens the extension menu and focuses the conversation entry"
msgstr "Opent het extensiemenu en zet de cursor in het gespreksveld"

#: prefs.js:1428
msgid "Menu entities"
msgstr "Entiteiten in het menu"

#: prefs.js:1429
msgid ""
"Controls in the popup menu. The control type adapts automatically by domain: "
"switch (switch, light, fan), slider (light brightness, volume, covers), "
"button (script, scene), dropdown (input_select), text or sensor."
msgstr ""
"Bedieningselementen in het uitklapmenu. Het type past zich automatisch aan "
"per domein: schakelaar (switch, light, fan), schuifregelaar (helderheid, "
"volume, zonwering), knop (script, scène), keuzelijst (input_select), tekst "
"of sensor."

#: prefs.js:1433
msgid "e.g. light.livingroom or switch.coffee"
msgstr "bijv. light.livingroom of switch.coffee"

#: prefs.js:1445 prefs.js:1543
msgid "Testing connection…"
msgstr "Verbinding wordt getest…"

#: prefs.js:1480
msgid "Music Assistant server connection settings"
msgstr "Verbindingsinstellingen voor de Music Assistant-server"

#: prefs.js:1485
msgid "Shows the player section in the menu and enables MPRIS control"
msgstr "Toont de spelersectie in het menu en activeert MPRIS-bediening"

#: prefs.js:1489
msgid "e.g. http://music-assistant:8095"
msgstr "bijv. http://music-assistant:8095"

#: prefs.js:1492
msgid "API key"
msgstr "API-sleutel"

#: prefs.js:1493
msgid "Optional — only if MA requires authentication"
msgstr "Optioneel — alleen als MA verificatie vereist"

#: prefs.js:1500
msgid "Checks the server and loads the players"
msgstr "Controleert de server en laadt de spelers"

#: prefs.js:1514 prefs.js:1518
msgid "Default player"
msgstr "Standaardspeler"

#: prefs.js:1515
msgid "Which player gets selected in the menu at startup"
msgstr "Welke speler bij het starten in het menu wordt geselecteerd"

#: prefs.js:1519
msgid "Player shown in the menu when opened"
msgstr "Speler die bij openen in het menu wordt getoond"

#: prefs.js:1524
msgid "Automatic (first playing)"
msgstr "Automatisch (eerst spelende)"

#: prefs.js:1572
msgid "MPRIS and media keys"
msgstr "MPRIS en mediasneltoetsen"

#: prefs.js:1573
msgid "Integration with the GNOME system media controls"
msgstr "Integratie met de mediabediening van GNOME"

#: prefs.js:1576
msgid "MPRIS bridge (media keys)"
msgstr "MPRIS-brug (mediasneltoetsen)"

#: prefs.js:1577
msgid ""
"Lets you control players with hardware keys and the GNOME media controls"
msgstr ""
"Laat je spelers bedienen met hardwaretoetsen en de mediabediening van GNOME"

#: prefs.js:1583
msgid "Players in MPRIS"
msgstr "Spelers in MPRIS"

#: prefs.js:1584
msgid ""
"Check the players from Music Assistant and Home Assistant. On name clash "
"Music Assistant wins."
msgstr ""
"Vink spelers van Music Assistant en Home Assistant aan. Bij dezelfde naam "
"heeft Music Assistant voorrang."

#: prefs.js:1598
msgid "Menu controls"
msgstr "Bediening in het menu"

#: prefs.js:1599
msgid "Choose the player widgets shown in the popup menu"
msgstr "Kies de spelerwidgets die in het uitklapmenu worden getoond"

#: prefs.js:1601
msgid "Player selector in menu"
msgstr "Spelerkeuze in het menu"

#: prefs.js:1602
