#: prefs.js:1621
msgid "Color indicator of Home Assistant and Music Assistant status"
msgstr "Kleurindicator van de status van Home Assistant en Music Assistant"

#: prefs.js:1621
msgid "Show connection status (dots)"
msgstr "Verbindingsstatus tonen (stippen)"

#: prefs.js:1625
msgid "Interface"
msgstr "Interface"

#: prefs.js:1626
msgid "Extension interface language"
msgstr "Taal van de extensie-interface"

#: prefs.js:1628
msgid "Interface language"
msgstr "Interfacetaal"

#: prefs.js:1629
msgid ""
"Automatic follows the system language. The menu updates right away; reopen "
"this window to translate it too."
msgstr ""
"Volgt automatisch de systeemtaal. Het menu wordt meteen bijgewerkt; open dit "
"venster opnieuw om het ook te vertalen."

#: prefs.js:1634
msgid "Automatic (follow system)"
